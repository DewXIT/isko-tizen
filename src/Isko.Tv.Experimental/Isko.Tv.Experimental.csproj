<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(BuildForTizen)' != 'true'">net6.0</TargetFramework>
    <TargetFramework Condition="'$(BuildForTizen)' == 'true'">net6.0-tizen9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TizenCreateTpkOnBuild Condition="'$(BuildForTizen)' == 'true'">true</TizenCreateTpkOnBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildForTizen)' != 'true'">
    <PackageReference Include="Tizen.NET.API12" Version="12.0.0.18510" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Isko.Protection/Isko.Protection.csproj" />
    <ProjectReference Include="../Isko.Core/Isko.Core.csproj" />
    <Compile Include="../Isko.Tv/Program.cs" Link="Program.cs" />
    <Compile Include="../Isko.Tv/PageEngine.cs" Link="PageEngine.cs" />
    <Compile Include="../Isko.Tv/PageScripts.cs" Link="PageScripts.cs" />
    <Compile Include="../Isko.Tv/Measurements.cs" Link="Measurements.cs" />
    <Compile Include="../Isko.Tv/SessionStore.cs" Link="SessionStore.cs" />
    <Compile Include="../Isko.Tv/SiteIcons.cs" Link="SiteIcons.cs" />
    <Compile Include="../Isko.Tv/UiIcons.cs" Link="UiIcons.cs" />
    <Compile Include="../Isko.Tv/ProtectedPageEngine.cs" Link="ProtectedPageEngine.cs" />
  </ItemGroup>
</Project>
