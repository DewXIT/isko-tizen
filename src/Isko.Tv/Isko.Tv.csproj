<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Default is a reference-assembly compilation, NOT a TV package. -->
    <TargetFramework Condition="'$(BuildForTizen)' != 'true'">net6.0</TargetFramework>
    <!-- The TV's .NET runtime decides the target: net6.0 is end-of-life for desktops, not for this device (see docs/install.md). -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IskoTizenTfm Condition="'$(IskoTizenTfm)' == ''">net6.0-tizen9.0</IskoTizenTfm>
    <TargetFramework Condition="'$(BuildForTizen)' == 'true'">$(IskoTizenTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TizenCreateTpkOnBuild Condition="'$(BuildForTizen)' == 'true'">true</TizenCreateTpkOnBuild>
  </PropertyGroup>
  <!-- Developer-only: open this address at launch (no remote typing). Empty in every normal package. -->
  <PropertyGroup>
    <IskoStartUrl Condition="'$(IskoStartUrl)' == ''"></IskoStartUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="IskoStartUrl" Value="$(IskoStartUrl)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IskoRuntimeDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);ISKO_RUNTIME_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildForTizen)' != 'true'">
    <PackageReference Include="Tizen.NET.API12" Version="12.0.0.18510" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Isko.Protection/Isko.Protection.csproj" />
    <ProjectReference Include="../Isko.Core/Isko.Core.csproj" />
  </ItemGroup>
</Project>
